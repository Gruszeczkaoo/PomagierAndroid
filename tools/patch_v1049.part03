      const ed=Math.max(0,Number(def)||0)*(1-cap(Number(pen||0)/100,0,.60));
      return Math.max(1,Number(atk)||0)*(1000/(1000+ed))*(1-cap(Number(dr||0)/100,0,.70))*(1-cap(evasionDr,0,.25))*(2/3);
    };

