    const contacts=Math.max(.2,hit*(1+doubleP)*Math.min(turns,5));
    const bleedActive=1-Math.pow(1-bleedPerContact,contacts);
    const bleedDpt=Math.max(0,Number(o.maxHp||meta.medianOpponentHp||1600))*.02*bleedActive*.62;

    const stunP=cap(Number(c.stun_chance_percent||0)/100,0,.35)*hit*cap(1-Number(o.stunResist||0)/100,0,1);
    const stunActionsSaved=Math.min(1,stunP*Math.max(1,