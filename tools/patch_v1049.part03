    const basicDpt=basicBase*hit*critF*momentum*firstStrike;
    const doubleP=cap(Number(c.double_strike_percent||0)/100,0,Number(stats.caps?.double_strike_percent||40)/100);
    const secondDpt=basicBase*doubleP*hit*critF*momentum;
    const counterChance=cap(Number(c.counter_attack_percent||0)/100,0,.40);
    const counterDpt=basicBase*.75*(1-enemyHit)*counterChance*critF*momentum;

    const bleedNormal=cap((Number(c.bleed_chance_percent||0)-Number(o.bleedResist||0))/100,0,.95);
    const bleedCrit=(cond.appliesBleed?crit*cap(1-Number(o.bleedResist||0)/100,0,1):0);
