    const enemyHit=cap((Number(o.accuracy||110)-Number(c.evasion_percent||0))/100,.05,1);
    const myEvadeDR=cap(Number(stats.evasionDamageReductionPercent||0)/100,0,.25);
    const oppEvadeDR=cap(Number(o.evasion||0)/350,0,.25);

