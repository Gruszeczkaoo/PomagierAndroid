    let lowRegen=0;
    for(const x of (cond.regenLow||[])) lowRegen+=Number(x.value||0)*uptime(x);

    const momentum=1+Math.max(0,Number(r.attack_per_turn_percent||0))*Math.max(0,(turns-1)/2)/100;
    const firstStrike=1+Math.max(0,Number(c.first_strike_percent||0))/100/Math.max(1,turns);
