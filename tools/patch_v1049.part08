breakthroughs);
    await sleep(70);
    const resetInfo=await apiActive(`/api/pvp/${id}/reset-info`).catch(()=>null);
    if(resetInfo) pvpLabSetCurrent('pvp_reset_info',resetInfo);
    await pvpLabRefreshSkillTrees();
  }""")

s=s.replace("⚔ PvP Lab META","⚔ PvP Engine v2 • V6",1)
s=s.replace("🧠 BEST BUILD — REALNE PvP 1:1","🧠 BEST BUILD — V6 MECHANICS + REALNE PvP",1)

needle="    const bestMeta=opt.status==='OK'&&opt.best"
idx=s.find(needle)
if idx<0: raise SystemExit("Brak bestMeta w PvP HTML")
ret=s.find("    return `",idx)
if ret<0: raise SystemExit("Brak return po bestMeta")
if "const engineMeta=" not in s[idx:ret]:
    extra="""    const engineMeta=opt.status==='OK'
      ? `<div class="sub"><b>ENGINE ${esc(opt.combatEngine||'v6')}</b> • balans ${esc(opt.balanceVersion||'—')} • punkty ${Number(opt.current?.usedPoints||0)}/${Number(opt.totalAttributePoints||0)} • Przełamania BEST: ${esc((opt.best?.breakthroughs?.recommendedNames||[]).join(' / ')||'brak aktywnych')}</div>`
      : '';
"""
    s=s[:ret]+extra+s[ret:]

s=s.replace("${bestMeta}<div class=\"sub\">CEL: REALNE PvP 1:1", "${bestMeta}${engineMeta}<div class=\"sub\">CEL: REALNE PvP 1:1",1)
s=s.replace("Optimizer: ${esc(opt.status||'CZEKA')}. Synchronizacja pobierze historię PRESTIŻ", "Optimizer v2: ${esc(opt.status||'CZEKA')}. Synchronizacja pobierze historię PRESTIŻ",1)
s=s.replace("attributes, summary, build i 5 skill-tree.", "attributes, summary, build, breakthroughs, reset-info i 5 skill-tree.",1)

