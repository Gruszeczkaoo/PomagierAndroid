turns*.55));

    const directOut=Math.max(1,basicDpt+secondDpt+counterDpt);
    const outDpt=directOut+bleedDpt;

    const execute=cap(Number(c.execute_threshold_percent||0)/100,0,.18);
    const targetHp=Math.max(1,Number(o.maxHp||meta.medianOpponentHp||1600))*(1-execute);
    const healRedToEnemy=cap(Number(c.healing_reduction_percent||0)/100,0,.50);
    const enemyHeal=Math.max(0,Number(o.regen||0))*(1-healRedToEnemy) +
      basicDpt*cap(Number(o.lifesteal||0)/100,0,.30)*(1-healRedToEnemy);
    const netOut=Math.max(1,outDpt-enemyHeal);

    const enemyBase=direct(Number(o.attack||700),stats.defense,Number(o.armorPen||28),Number(c.damage_taken_reduction_percent||0),myEvadeDR)*lowDrF;
    const enemyCritF=1+enemyCrit*enemyCritBonus;
    const enemyDouble=cap(Number(o.doubleStrike||0)/100,0,.55);
    let incomingDirect=enemyBase*enemyHit*enemyCritF*(1+enemyDouble);
    incomingDirect=Math.max(0,incomingDirect-enemyBase*stunActionsSaved/Math.max(1,turns));

    const enemyBleedP=cap((Number(o.bleedChance||35)-Number(c.bleed_resist_percent||0))/100,0,.95);
    const enemyContacts=Math.max(.2,enemyHit*(1+enemyDouble)*Math.min(turns,5));
    const enemyBleedActive=1-Math.pow(1-enemyBleedP,enemyContacts);
    const enemyBleedDpt=Math.max(0,stats.maxHp)*.02*enemyBleedActive*.62;
    const incomingDpt=Math.max(1,incomingDirect+enemyBleedDpt);

    const healRedToMe=cap(Number(o.healingReduction||25)/100,0,.50);
    const regen=Math.min(Number(stats.roundCap||136),Number(stats.regen||0)+lowRegen)*(1-healRedToMe);
    const lifesteal=directOut*cap(Number(c.lifesteal_percent||0)/100,0,.30)*(1-healRedToMe);
    const sustainPerRound=regen+lifesteal;

    const killTurns=targetHp/netOut;
    const survivalTurns=Math.max(1,stats.maxHp)/(Math.max(1,incomingDpt-sustainPerRound));
    const offense=Math.max(1,netOut)*(1+Math.max(0,15-killTurns)/100);
    const survival=Math.max(1,stats.maxHp+sustainPerRound*turns)*(1+Math.max(0,survivalTurns-turns)/100);
    const closeBoost=Math.min(.14,Number(meta.close15||0)/Math.max(1,meta.n||1));
    const ow=.52-closeBoost/2, sw=.48+closeBoost/2;
    let score=Math.exp(Math.log(offense)*ow + Math.log(survival)*sw);

    if(includeBreakthrough){
      const bt=pvpLabBreakthroughPlan(stats,meta);
      score*=1+Math.min(.08,Number(bt.utility||0)*.025);
    }
    return Number.isFinite(score)?score:-Infinity;
  }""")

