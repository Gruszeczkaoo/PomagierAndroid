  function pvpLabConditionalEffects(attrs,plan){
    const out={attackLow:[],damageReductionLow:[],regenLow:[],appliesBleed:false};
    if(!attrs || !plan) return out;
    for(const k of ['str','end','agi','vit','prc']){
      const opts=pvpLabSkillOptions(k,Number(attrs[k]||0));
      const letters=String(plan[k]||'');
      opts.forEach((t,i)=>{
        const sk=t.skills.find(x=>x.option===(letters[i]||'')); if(!sk) return;
        const b=pvpLabSkillBonuses(sk), thr=Number(b.low_hp_threshold||0);
        if(Number(b.attack_percent_low_hp||0)>0) out.attackLow.push({value:Number(b.attack_percent_low_hp),threshold:thr||50});
        if(Number(b.damage_taken_reduction_low_hp_percent||0)>0) out.damageReductionLow.push({value:Number(b.damage_taken_reduction_low_hp_percent),threshold:thr||50});
        if(Number(b.hp_regen_low_hp_flat||0)>0) out.regenLow.push({value:Number(b.hp_regen_low_hp_flat),threshold:thr||50});
