replace_func("pvpLabCaps",r"""  function pvpLabCaps(attrs=null,maxHp=null){
    const a=attrs||pvpLabCurrentAttrs()||{};
    const agi=Number(a.agi||0),prc=Number(a.prc||0),vit=Number(a.vit||0);
    const server=pvpLab.current?.summary?.statCaps||{};
    const out={
      evasion_percent:55,double_strike_percent:40,counter_attack_percent:40,crit_chance_percent:65,
      armor_pen_percent:50,damage_taken_reduction_percent:60,stun_resist_percent:60,bleed_resist_percent:60,
      healing_reduction_percent:50,execute_threshold_percent:18,crit_resist_percent:50,accuracy_percent:140,
      crit_damage_percent:130,lifesteal_percent:30,stun_chance_percent:35
    };
    if(agi>40){
      out.evasion_percent=55+Math.min(10,agi-40)*.5;
      out.double_strike_percent=40+Math.min(10,agi-40)*1.5;
    }
    if(prc>40) out.crit_chance_percent=65+Math.min(10,prc-40)*1.5;
    for(const k of Object.keys(out)){
      if(['evasion_percent','double_strike_percent','crit_chance_percent'].includes(k)) continue;
      if(Number.isFinite(Number(server[k]))) out[k]=Number(server[k]);
    }
    if(Number.isFinite(Number(maxHp))) out.hp_regen_flat=vit<=40?20:Math.max(20,Number(maxHp)*(.003*Math.min(10,vit-40)));
    else out.hp_regen_flat=20;
    return out;
  }""")

replace_func("pvpLabEffective",r"""  function pvpLabEffective(v,attrs=null,maxHp=null){
    const out={...v}, caps=pvpLabCaps(attrs,maxHp);
    for(const [k,c] of Object.entries(caps)){
      if(k==='hp_regen_effective' || k==='hp_regen_flat') continue;
      if(Number.isFinite(Number(out[k]))) out[k]=Math.min(Number(c),Number(out[k]));
    }
    return out;
  }""")

